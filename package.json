{
  "name": "restate-ts-template",
  "version": "0.0.1",
  "description": "Template for JavaScript/TypeScript services running with Restate (https://github.com/restatedev/)",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bundle": "pnpm --filter @restate-agents/core build && pnpm --filter @restate-agents/example bundle",
    "app": "pnpm -r build && pnpm --filter @restate-agents/example start",
    "app-dev": "pnpm --filter @restate-agents/core build && pnpm --filter @restate-agents/example dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}
