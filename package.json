{
  "name": "restate-agent-reference",
  "version": "0.0.1",
  "description": "Reference implementation of a durable agent on Restate.",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bundle": "pnpm --filter @restate-agents/example bundle",
    "app": "pnpm --filter @restate-agents/example build && pnpm --filter @restate-agents/example start",
    "app-dev": "pnpm --filter @restate-agents/example dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}
