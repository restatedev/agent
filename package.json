{
  "name": "restate-agent-reference",
  "version": "0.0.1",
  "description": "Reference implementation of a durable agent on Restate.",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bundle": "pnpm --filter @restate-agents/types build && pnpm --filter @restate-agents/core bundle",
    "start": "pnpm --filter @restate-agents/core... build && pnpm --filter @restate-agents/core start",
    "start:ui": "pnpm --filter @restate-agents/web... build && pnpm --filter @restate-agents/web start",
    "dev": "pnpm --filter @restate-agents/client... build && pnpm --parallel --filter @restate-agents/core --filter @restate-agents/web dev",
    "dev:service": "pnpm --filter @restate-agents/types build && pnpm --filter @restate-agents/core dev",
    "dev:ui": "pnpm --filter @restate-agents/client... build && pnpm --filter @restate-agents/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}
