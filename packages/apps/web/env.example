# Local demo only: there is no login or account isolation.
# Restate ingress as seen by the Next.js server, never sent to the browser.
RESTATE_INGRESS_URL=http://localhost:8080
# Optional for an authenticated Restate ingress.
RESTATE_AUTH_TOKEN=
# Optional public origin when the UI sits behind a proxy. Requests must then
# carry this URL's host; writes must carry this origin.
# APP_PUBLIC_URL=https://agents.example.com
# Optional comma-separated Host values also accepted, for proxies that rewrite
# Host to an internal name. Only list names an attacker's DNS cannot claim.
# APP_ALLOWED_HOSTS=web.internal:3000
PORT=3000
