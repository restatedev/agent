# Restate ingress as seen by the Next.js server. The browser never receives it.
RESTATE_INGRESS_URL=http://localhost:8080

# Optional. Leave unset for a local Restate server.
RESTATE_AUTH_TOKEN=

# Sign in with Google (Web application OAuth client; identity only, not Gmail).
APP_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign-in always requires Google's verified Workspace domain to be restate.dev.
# Optional comma-separated emails to further restrict access within restate.dev.
GOOGLE_ALLOWED_EMAILS=

# Same server-only key on the BFF and core service. Unset defaults to "restate"
# outside production only. Production requires a strong random secret >=32 bytes.
# APP_SECRET_KEY=

# Next.js server settings.
PORT=3000
HOSTNAME=0.0.0.0
