{
  "name": "@restate-agents/runtime",
  "version": "0.0.1",
  "description": "Durable Restate services for the reference agent runtime.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.mjs",
    "build": "tsc --noEmitOnError",
    "start": "NODE_ENV=production node ./dist/app.js",
    "dev": "tsx watch ./src/app.ts",
    "prebundle": "rm -rf dist",
    "bundle": "esbuild src/app.ts --bundle --format=esm --minify --sourcemap --platform=node --target=node22 --banner:js=\"import { createRequire as __restateCreateRequire } from 'node:module'; const require = __restateCreateRequire(import.meta.url); const __dirname = import.meta.dirname;\" --outfile=dist/app.js",
    "postbundle": "cd dist && zip -r index.zip app.js*"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.10",
    "@restate-agents/core": "file:../../../vendor/restate-agents-core-346e8fe.tgz",
    "@restate-agents/types": "workspace:*",
    "@restatedev/restate-sdk": "1.17.2",
    "@restatedev/restate-sdk-gen": "1.17.2",
    "modal": "^0.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.4",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
