{
  "name": "@restate-agents/core",
  "version": "0.0.1",
  "description": "Core agent framework (types + runtime) for Restate.",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc --noEmitOnError"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "^1.16.2",
    "@restatedev/restate-sdk-gen": "^1.16.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^6.0.3"
  }
}
