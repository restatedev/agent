{
  "name": "@restate-agents/core",
  "version": "0.0.1",
  "description": "Durable Restate services for the reference agent runtime.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsc -p test/tsconfig.json && node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:restart": "node --import tsx test/restart.mjs",
    "build": "tsc --noEmitOnError",
    "start": "NODE_ENV=production node ./dist/app.js",
    "dev": "tsx watch ./src/app.ts",
    "prebundle": "rm -rf dist",
    "bundle": "esbuild src/app.ts --bundle --format=esm --minify --sourcemap --platform=node --target=node22 --banner:js=\"import { createRequire as __restateCreateRequire } from 'node:module'; const require = __restateCreateRequire(import.meta.url); const __dirname = import.meta.dirname;\" --outfile=dist/app.js",
    "postbundle": "cd dist && zip -r index.zip app.js*"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/deepseek": "^3.0.54",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/xai": "^5.0.10",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.31.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@restate-agents/types": "workspace:*",
    "@restatedev/restate-sdk": "1.17.0",
    "@restatedev/restate-sdk-gen": "1.17.0",
    "ai": "^7.0.118",
    "minisearch": "7.2.0",
    "modal": "^0.9.0",
    "quickjs-emscripten-core": "0.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.4",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
