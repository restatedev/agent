{
  "name": "@restate-agents/pi",
  "version": "0.0.1",
  "description": "Pi Durable embedded in Restate: the journal is Pi's commit log.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
