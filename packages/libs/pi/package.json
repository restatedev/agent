    "build": "tsc --noEmitOnError"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-durable": "1.0.1",
    "@restatedev/restate-sdk": "1.17.0",
    "@restatedev/restate-sdk-gen": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
